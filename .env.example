JOBPUNTER_ENVIRONMENT=development
# Required outside development. Inject the exact deployed Git commit (7-40 lowercase hex characters).
JOBPUNTER_DEPLOYMENT_REVISION=
DATABASE_URL=postgresql+psycopg://jobpunter:jobpunter@localhost:5432/jobpunter
# Per-process connection pool (defaults are SQLAlchemy's own: 5 + 10 overflow, no recycle).
# For a pooled (PgBouncer) host such as Neon's -pooler endpoint, small values are enough, e.g. 3 / 2 / 300.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=-1
# Optional database size alerts shown in GET /api/v1/admin/operations/summary (Neon Free caps storage at 1 GB).
# DATABASE_SIZE_WARNING_BYTES=800000000
# DATABASE_SIZE_CRITICAL_BYTES=950000000

# Trusted identity-provider adapter. Firebase is the implemented provider; unsupported values fail closed.
JOBPUNTER_IDENTITY_PROVIDER=firebase

# Required for verifying Google sign-in ID tokens on the backend.
FIREBASE_PROJECT_ID=

# AI provider configuration is server-side only. Never expose these as NEXT_PUBLIC_* variables.
JOBPUNTER_AI_PROVIDER=google
JOBPUNTER_GOOGLE_AI_MODEL=gemini-2.5-flash
JOBPUNTER_GOOGLE_AI_API_KEY=

# Optional: development identity header is accepted only when explicitly opted in.
# Startup configuration rejects this flag unless JOBPUNTER_ENVIRONMENT=development.
JOBPUNTER_ALLOW_DEV_IDENTITY=false

# Private document storage. R2 is the default authoritative store.
DOCUMENT_STORAGE_PROVIDER=r2
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_RETENTION_DAYS=30

# Optional controlled migration to Google Cloud Storage. Do not configure both expecting replication.
GOOGLE_CLOUD_STORAGE_BUCKET=

# Optional scanned-PDF OCR via Google Cloud Vision. Disabled until the service account is authorized.
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_TIMEOUT_SECONDS=30
DOCUMENT_OCR_BATCH_SIZE=8

# Optional personal Google Drive backup; disabled by default.
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Optional legacy SMTP fallback. Admin-managed SMTP credentials require a stable Fernet key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the generated key in the runtime secret manager; never commit a real key.
JOBPUNTER_SMTP_SECRET_ENCRYPTION_KEY=

# Optional SMTP email delivery. In-app notifications work without these values.
# Users must opt in and have a verified email address before delivery is queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Optional browser CORS allow-list. Comma-separated HTTP(S) origins only, without paths.
# Leave empty for same-origin deployment. Wildcard origins are rejected.
JOBPUNTER_CORS_ALLOWED_ORIGINS=

# Protected worker-cycle trigger (optional). Leave unset to disable. Must be a random secret of 32+ characters.
WORKER_TRIGGER_SECRET=
WORKER_TRIGGER_BATCH_SIZE=5
WORKER_TRIGGER_WORKER_TIMEOUT_SECONDS=60
WORKER_TRIGGER_TOTAL_SECONDS=240
WORKER_TRIGGER_MIN_FREE_MB=200
